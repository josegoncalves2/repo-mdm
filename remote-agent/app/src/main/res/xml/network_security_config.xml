<?xml version="1.0" encoding="utf-8"?>
<!--
  Politica de rede do agente de suporte, igual a do launcher.

  Sem isto o aplicativo nao conecta em servidor sem TLS. Desde o Android 9 o trafego em
  texto claro e' proibido por padrao quando targetSdk >= 28, e a recusa acontece dentro da
  pilha de rede: o WebSocket falha antes de sair do aparelho, sem erro visivel em lugar
  nenhum. Foi exatamente esse o sintoma na primeira versao — o usuario autorizava a
  captura e nada mais acontecia.

  O relay e' o mesmo host com que o launcher ja sincroniza (base.url do servidor MDM), que
  nesta instalacao atende em http simples numa rede local. Quando o servidor passar a
  atender em https, a URL vira wss sozinha (ver RemoteSupportResource#agentSocketUrl) e
  esta permissao deixa de ser exercida.

  As ancoras de confianca incluem "user" pelo mesmo motivo do launcher: instalacoes com
  certificado proprio da prefeitura instalam a CA no aparelho.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
