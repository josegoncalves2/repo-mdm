# Modelo de configuracao do ambiente. Copie para source/.env e ajuste.
#   cp source/.env.example source/.env
# O scripts/provision.sh faz isso perguntando os valores, se preferir.
#
# ATENCAO: source/.env NAO e' versionado (carrega segredos). Este modelo e'.

# ---------- Banco de dados ----------
SQL_USER=hmdm
SQL_BASE=hmdm
SQL_PASS=Gg18Yj47YT820ZZEZIaWWUPj

# ---------- Endereco do servidor ----------
# Dominio pelo qual os tablets E o painel alcancam este servidor.
# E' gravado no QR code de matricula: errado aqui = nenhum tablet matricula.
BASE_DOMAIN=192.168.1.75:8080

# IP da maquina que roda o Docker, na rede em que os tablets a enxergam.
# O container o escreve no /etc/hosts para resolver BASE_DOMAIN internamente.
# Descubra com:  ip -4 addr show | grep inet
LOCAL_IP=192.168.1.75

# PROTOCOL        = como o container fala consigo mesmo (quase sempre http)
# PUBLIC_PROTOCOL = como o mundo alcanca o servidor (https se houver proxy TLS)
PROTOCOL=http
PUBLIC_PROTOCOL=http

# ---------- Proxy reverso / tunel ----------
# IPs dos saltos confiaveis entre o tablet e o Tomcat, separados por virgula.
# Sem isto o Tomcat ignora o X-Forwarded-For e o painel passa a mostrar o IP do
# proxy no lugar do IP de origem do dispositivo.
# Deixe vazio se nao houver proxy algum na frente.
PROXY_ADDRESSES=192.168.1.254,192.168.250.254

# ---------- Conta inicial ----------
ADMIN_EMAIL=admin@olimpia.sp.gov.br

# ---------- Segredo compartilhado ----------
# Assina as requisicoes de configuracao do agente.
# Ao RESTAURAR um dump existente, mantenha o MESMO valor do ambiente de origem,
# senao os dispositivos ja matriculados deixam de ser reconhecidos.
# Para instalacao nova, gere um:  openssl rand -hex 24
SHARED_SECRET=58ac494a140de4b6c2d89f911fba1a8c44bb155c28156b92

# ---------- Variante e versao ----------
HMDM_VARIANT=os
CLIENT_VERSION=6.36
DOWNLOAD_CREDENTIALS=
# Vazio = usa o WAR ja presente em source/volumes/work/cache/.
# O provision.sh baixa um se a pasta estiver vazia.
HMDM_URL=

# true reescreve ROOT.xml e init.sql no proximo boot a partir dos valores acima.
# Deixe true na PRIMEIRA subida numa maquina nova; depois volte para false.
FORCE_RECONFIGURE=true
