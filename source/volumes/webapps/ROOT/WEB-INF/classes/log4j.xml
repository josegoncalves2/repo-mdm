<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/" debug="false">

    <appender name="stdout" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss} [%p] %-10c : %m%n"/>
        </layout>
    </appender>

    <logger name="AuditLogger" additivity="false">
        <level value="DEBUG"/>
        <appender-ref ref="stdout"/>
    </logger>

    <!-- Suppress 'Stealing link for clientId ...' warnings -->
    <logger name="org.apache.activemq.broker.region.RegionBroker">
        <level value="ERROR"/>
    </logger>

    <!-- Suppress 'Empty constructor called!' — Tomcat instantiates the servlet
         via the no-arg constructor before dependency injection; this is expected
         behavior, not an error. -->
    <logger name="com.hmdm.notification.rest.LongPollingServlet">
        <level value="FATAL"/>
    </logger>

    <!-- Suppress MyBatis/VFS class-not-found debug noise -->
    <logger name="org.apache.ibatis.io">
        <level value="WARN"/>
    </logger>

    <!-- Suppress Liquibase resource scanning debug noise -->
    <logger name="liquibase">
        <level value="WARN"/>
    </logger>

    <!-- Suppress ActiveMQ MQTT ping debug noise -->
    <logger name="org.apache.activemq.transport.mqtt">
        <level value="WARN"/>
    </logger>

    <root>
        <level value="DEBUG"/>
        <appender-ref ref="stdout"/>
    </root>

</log4j:configuration>