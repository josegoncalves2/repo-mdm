# Modelo de configuracao do ambiente. Copie para source/.env e ajuste.
#   cp source/.env.example source/.env
# O scripts/provision.sh faz isso perguntando os valores, se preferir.
#
# ATENCAO: source/.env NAO e' versionado (carrega segredos). Este modelo e'.

# ---------- Banco de dados ----------
SQL_USER=hmdm
SQL_BASE=hmdm
SQL_PASS=TROQUE_ESTA_SENHA

# ---------- Endereco do servidor ----------
# Dominio pelo qual os tablets E o painel alcancam este servidor.
# E' gravado no QR code de matricula: errado aqui = nenhum tablet matricula.
BASE_DOMAIN=

# IP da maquina que roda o Docker, na rede em que os tablets a enxergam.
# O container o escreve no /etc/hosts para resolver BASE_DOMAIN internamente.
# Descubra com:  ip -4 addr show | grep inet
LOCAL_IP=

# PROTOCOL        = como o container fala consigo mesmo (quase sempre http)
# PUBLIC_PROTOCOL = como o mundo alcanca o servidor (https se houver proxy TLS)
PROTOCOL=http
PUBLIC_PROTOCOL=https

# ---------- Proxy reverso / tunel ----------
# IPs dos saltos confiaveis entre o tablet e o Tomcat, separados por virgula.
# Sem isto o Tomcat ignora o X-Forwarded-For e o painel passa a mostrar o IP do
# proxy no lugar do IP de origem do dispositivo.
# Deixe vazio se nao houver proxy algum na frente.
PROXY_ADDRESSES=

# ---------- Conta inicial ----------
ADMIN_EMAIL=admin@exemplo.com.br

# ---------- Segredo compartilhado ----------
# Assina as requisicoes de configuracao do agente.
# Ao RESTAURAR um dump existente, mantenha o MESMO valor do ambiente de origem,
# senao os dispositivos ja matriculados deixam de ser reconhecidos.
# Para instalacao nova, gere um:  openssl rand -hex 24
SHARED_SECRET=TROQUE_ESTE_SEGREDO

# ---------- Variante e versao ----------
HMDM_VARIANT=os
CLIENT_VERSION=6.36
DOWNLOAD_CREDENTIALS=
# Vazio = usa o WAR ja presente em source/volumes/work/cache/.
# O provision.sh baixa um se a pasta estiver vazia.
HMDM_URL=

# ---------- Versao da plataforma (rodape e Sobre) ----------
# Acompanha a ultima tag git (vX.Y.Z). Commit e data saem do .git montado.
HWMDM_VERSION=2.0.0
HWMDM_GIT_DIR=../.git
HWMDM_GIT_MOUNT=/opt/hwmdm/git
# Pacotes cuja versao publicada (applications.latestversion) aparece no Sobre.
HWMDM_AGENT_PKGS=com.hmdm.launcher,com.hwmdm.remote,com.hwmdm.webfilter

# true reescreve ROOT.xml e init.sql no proximo boot a partir dos valores acima.
# Deixe true na PRIMEIRA subida numa maquina nova; depois volte para false.
FORCE_RECONFIGURE=false

# ---------- Portas publicadas no host ----------
# Painel/API no Tomcat. PUBLIC = porta padrao do esquema (80), para URLs sem ":porta".
MDM_HTTP_PORT=8080
MDM_PUBLIC_PORT=80
MDM_PUSH_PORT=31000
POSTGRES_PORT=5432

# ---------- Rede (duas NICs) ----------
# Toda porta publicada escuta so no endereco indicado aqui; sem bind o Docker publica em
# todas as NICs e passa por cima do firewalld.
# MGMT_BIND_ADDR   = NIC de gerencia: painel (MDM_HTTP_PORT) e hwmdm-admin (ADMIN_PORT).
# DEVICE_BIND_ADDR = NIC dos dispositivos: MDM_PUBLIC_PORT e MDM_PUSH_PORT, por onde os tablets
#                    (e o proxy externo) chegam. Com uma NIC so, repita o IP de gerencia.
# POSTGRES_BIND_ADDR = so a propria maquina; acesso remoto ao banco por tunel SSH.
MGMT_BIND_ADDR=
DEVICE_BIND_ADDR=
POSTGRES_BIND_ADDR=127.0.0.1
# Endereco onde o DNS do Web Filter escuta a porta 53. Vazio = LOCAL_IP.
WEBFILTER_BIND_ADDR=

# ---------- Publicacao de APK (scripts/publicar-apk.sh) ----------
# Sufixo do nome do APK publicado: hmdm-<versao>-<sufixo>.apk. Vazio = sem sufixo.
APK_SUFIXO=
# Sufixo do nome do APK publicado: hmdm-<versao>-<sufixo>.apk. Vazio = sem sufixo.
APK_SUFIXO=olimpia

# ---------- Servidor (tambem editavel em Servidor, no painel) ----------
# dev = SERVIDOR-DEV (desenvolvimento/homologacao); prd = SERVIDOR-PRD (producao)
SERVER_MODE=dev
SERVER_DEV_URL=http://mdm.pmeto.local
SERVER_PRD_URL=https://mdm.olimpia.sp.gov.br
TZ=America/Sao_Paulo
# Pasta raiz do repositorio no host (o hwmdm-admin a monta no mesmo caminho)
HWMDM_ROOT=
ADMIN_PORT=8090

WEBFILTER_CERTS_DIR=./webfilter/certs

# ---------- Compose: imagens, containers e politicas ----------
COMPOSE_PROJECT_NAME=hwmdm
RESTART_POLICY=unless-stopped
POSTGRES_IMAGE=postgres:12-alpine
POSTGRES_CONTAINER_NAME=hwmdm-postgres
MDM_IMAGE=headwindmdm/hmdm:0.1.8
MDM_CONTAINER_NAME=hwmdm-mdm
WEBFILTER_IMAGE=hwmdm/webfilter-dns:0.34.0
WEBFILTER_CONTAINER_NAME=hwmdm-webfilter
ADMIN_IMAGE=hwmdm/admin:1.0.0
ADMIN_CONTAINER_NAME=hwmdm-admin
DOCKER_SOCKET=/var/run/docker.sock

# ---------- Postgres ----------
SQL_HOST=postgresql
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DATA_DIR=/var/lib/postgresql/data
SQL_DUMP_FILE=./sql/hmdm-dump.sql.gz
POSTGRES_INITDB_DUMP=/docker-entrypoint-initdb.d/10-hmdm-dump.sql.gz
POSTGRES_HEALTH_INTERVAL=5s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=30
POSTGRES_HEALTH_START_PERIOD=10s

# ---------- MDM (Tomcat) ----------
MDM_INTERNAL_HTTP_PORT=8080
MDM_INTERNAL_PUSH_PORT=31000
MDM_WAR_FILE=../dist/hmdm.war
MDM_WAR_CACHE_FILE=/usr/local/tomcat/work/cache/hmdm-5.39.2-os.war
MDM_UMASK=0022
APPLY_CUSTOM_WEBAPP_ON_BOOT=false
AUTO_UPDATE_WEBAPP=false
# IPs de infraestrutura (proxy/tunel) que nunca sao tratados como IP do dispositivo. Separados por virgula.
INFRASTRUCTURE_IPS=

# ---------- Web Filter (resolvedor DNS / Blocky) ----------
WEBFILTER_APP_DIR=/app
WEBFILTER_DNS_DIR=/app/dns
WEBFILTER_LISTS_DIR=/app/lists
WEBFILTER_STATE_DIR=/app/state
WEBFILTER_SEED_DIR=/app/seed-lists
WEBFILTER_CERTS_MOUNT=/app/certs
WEBFILTER_CERT_FILE=/app/certs/cert.pem
WEBFILTER_KEY_FILE=/app/certs/key.pem
WEBFILTER_QUERY_LOG_DIR=/app/queries
BLOCKY_BINARY=/usr/local/bin/blocky
WEBFILTER_LISTS_VOLUME=hwmdm-webfilter_webfilter-lists
WEBFILTER_STATE_VOLUME=hwmdm-webfilter_webfilter-state
WEBFILTER_LOOPBACK_ADDR=127.0.0.1
WEBFILTER_API_ADDR=127.0.0.1:4000
WEBFILTER_DNS_PORT=53
WEBFILTER_DOT_PORT=853
# Enderecos (alem do loopback) onde o DNS 53 e o DoT do Web Filter escutam, separados por virgula.
WEBFILTER_BIND_ADDRS=
WEBFILTER_DRY_RUN_DNS_PORT=5353
WEBFILTER_DRY_RUN_API_ADDR=127.0.0.1:4001
WEBFILTER_UPSTREAMS=tcp-tls:1.1.1.1:853,tcp-tls:8.8.8.8:853
WEBFILTER_UPSTREAM_STRATEGY=parallel_best
WEBFILTER_LOG_LEVEL=info
WEBFILTER_QUERY_LOG_TYPE=csv
WEBFILTER_QUERY_LOG_RETENTION_DAYS=7
WEBFILTER_CACHE_MAX_TIME=30m
WEBFILTER_CACHE_MAX_ITEMS=2048
WEBFILTER_CACHE_PREFETCHING=true
WEBFILTER_BLOCK_TYPE=nxDomain
WEBFILTER_BLOCK_TTL=1m
WEBFILTER_LISTS_REFRESH_PERIOD=4h
WEBFILTER_LISTS_LOADING_STRATEGY=failOnError
WEBFILTER_REFRESH_MAX_SECONDS=86400
WEBFILTER_REFRESH_MIN_SECONDS=3600
WEBFILTER_LOOP_SECONDS=5
# Segundos que o Blocky tem para carregar as listas e responder DNS antes de ser dado como falho.
WEBFILTER_HEALTH_TIMEOUT=600
WEBFILTER_HEALTH_POLL_SECONDS=1
WEBFILTER_RETRY_FIRST_SECONDS=120
WEBFILTER_RETRY_MAX_SECONDS=3600
WEBFILTER_RESTART_GOOD_SECONDS=10
WEBFILTER_API_REFRESH_ATTEMPTS=3
WEBFILTER_API_REFRESH_BACKOFF=1
WEBFILTER_API_TIMEOUT=30
WEBFILTER_DOWNLOAD_TIMEOUT=120
WEBFILTER_DNS_PROBE_TIMEOUT=2
WEBFILTER_STOP_TIMEOUT=20
WEBFILTER_HEALTHCHECK_INTERVAL=30s
WEBFILTER_HEALTHCHECK_TIMEOUT=30s
WEBFILTER_HEALTHCHECK_RETRIES=3
WEBFILTER_HEALTHCHECK_START_PERIOD=300s
WEBFILTER_MEM_LIMIT=3g
# Opcoes da JVM do supervisor (WebfilterResolver); o Blocky usa a memoria do container fora do heap.
WEBFILTER_JAVA_OPTS=-Xmx64m -XX:+UseSerialGC

# ---------- Status dos dispositivos ----------
# Sem reportar ha menos que isto = online (verde); menos que AWAY = sem resposta recente (amarelo); acima = offline (vermelho).
DEVICE_ONLINE_SECONDS=300
DEVICE_AWAY_SECONDS=900
# Parado ha mais que isto no mapa GPS = parada.
GPS_STOP_SECONDS=300

# ---------- Admin (hwmdm-admin) ----------
ADMIN_BIND_ADDR=0.0.0.0
ADMIN_HEALTH_HOST=127.0.0.1
ADMIN_ROLE_IDS=1,2
ADMIN_SESSION_TTL=28800
ADMIN_JOBS_FILE=/data/jobs.json
MDM_INTERNAL_URL=http://hmdm:8080
# Sal do hash de senha do Headwind (o mesmo do MDM; trocar invalida todas as senhas).
HMDM_PASS_SALT=

# ---------- Diversos ----------
MQTT_SERVER_URI=0.0.0.0:31000
WEBFILTER_PROBE_NAME=localhost.

# Opcoes da JVM do Tomcat do MDM (entropia nao-bloqueante para IDs de sessao)
MDM_CATALINA_OPTS=-Djava.security.egd=file:/dev/./urandom
