<!--
  ~
  ~ Headwind MDM: Open Source Android MDM Software
  ~ https://h-mdm.com
  ~
  ~ Modulo novo (tarefa E do change corrigir-12-itens): liga/desliga modulos NATIVOS do
  ~ console (Dispositivos, Kiosk, etc.) sem depender de recompilar o nucleo do WAR.
  ~
  ~ Por que um plugin novo, e nao a tabela "plugins" ja existente (usada por webfilter,
  ~ messaging, push...): a tabela "plugins"/"pluginsdisabled" e o codigo que a le
  ~ (PluginDAO, PluginList, o loader de $ocLazyLoad em app.js) sao infraestrutura
  ~ COMPARTILHADA por todos os plugins que ja funcionam em producao. Mudar essa tabela ou
  ~ esse codigo para caber "modulo nativo sem javascriptModuleFile" arrisca quebrar o Web
  ~ Filter e os demais plugins reais por um efeito colateral que nao da para prever sem
  ~ o bytecode exato do WAR em producao (o build de 2026-08-11 nao bate com este fonte).
  ~ Um jar aditivo, isolado, com sua propria tabela, e zero risco para o que ja funciona:
  ~ se algo aqui estiver errado, o pior caso e este jar nao ser copiado para o ar.
  -->

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <artifactId>moduleregistry</artifactId>

    <packaging>jar</packaging>
    <version>0.1.0</version>
    <name>Module Registry (manutencao de modulos nativos) for MDM Server</name>

    <parent>
        <groupId>com.hmdm.plugin</groupId>
        <artifactId>base</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.hmdm.plugin</groupId>
            <artifactId>platform</artifactId>
            <version>0.1.0</version>
        </dependency>
    </dependencies>

</project>
